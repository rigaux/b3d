\begin{Verbatim}[commandchars=\\\{\}]
      \PYG{k+kd}{function} \PYG{n+nx}{mapAuteurVersPlateforme} \PYG{p}{(}\PYG{n+nx}{doc}\PYG{p}{)} \PYG{p}{\PYGZob{}}
        \PYG{c+c1}{// Première boucle sur les articles}
        \PYG{k}{for} \PYG{n+nx}{article} \PYG{k}{in} \PYG{n+nx}{doc}\PYG{p}{.}\PYG{n+nx}{articles} \PYG{p}{\PYGZob{}}
          \PYG{c+c1}{// Second boucle sur les plateformes}
          \PYG{k}{for} \PYG{p}{(}\PYG{n+nx}{plateforme} \PYG{k}{in} \PYG{n+nx}{article}\PYG{p}{.}\PYG{n+nx}{plateforme}\PYG{p}{)} \PYG{p}{\PYGZob{}}
            \PYG{c+c1}{// La clé est donc le nom de la platforme. On l\PYGZsq{}acompagne}
            \PYG{c+c1}{// d\PYGZsq{}un document contenant l\PYGZsq{}auteur, le titre et l\PYGZsq{}année}
            \PYG{n+nx}{emit} \PYG{p}{(}\PYG{n+nx}{plateforme}\PYG{p}{,} \PYG{p}{\PYGZob{}}\PYG{l+s+s2}{\PYGZdq{}auteur\PYGZdq{}}\PYG{o}{:} \PYG{n+nx}{doc}\PYG{p}{.}\PYG{n+nx}{nom}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}titre\PYGZdq{}}\PYG{o}{:} \PYG{n+nx}{article}\PYG{p}{.}\PYG{n+nx}{titre}\PYG{p}{,}
                                \PYG{l+s+s2}{\PYGZdq{}année\PYGZdq{}}\PYG{o}{:} \PYG{n+nx}{article}\PYG{p}{.}\PYG{n+nx}{année}\PYG{p}{\PYGZcb{})}
          \PYG{p}{\PYGZcb{}}
         \PYG{p}{\PYGZcb{}}
       \PYG{p}{\PYGZcb{}}
\end{Verbatim}
