<!ELEMENT library (document|publisher)*>

<!ELEMENT document (ISBN?,author+,title,date?)>
<!ATTLIST document
	callnumber ID #REQUIRED
	language CDATA #IMPLIED
	status (old|average|new) "average"
	publishedby IDREF #IMPLIED
	related IDREFS #IMPLIED>

<!ELEMENT publisher EMPTY>
<!ATTLIST publisher 
	id ID #REQUIRED
	name CDATA #REQUIRED>

<!ELEMENT ISBN (#PCDATA)>
<!ELEMENT author (#PCDATA)>
<!ELEMENT title (#PCDATA)>
<!ELEMENT date (#PCDATA)>

<!ENTITY author "FG">
