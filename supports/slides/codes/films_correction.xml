<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE mes_donnees_cinema [
<!ELEMENT mes_donnees_cinema (les_films,les_acteurs)>
<!ELEMENT les_films (film*)>
<!ELEMENT film (titre,annee,realisation)>
<!ELEMENT titre (#PCDATA)>
<!ELEMENT annee (#PCDATA)>
<!ELEMENT realisation (#PCDATA)>
<!ELEMENT les_acteurs (acteur*)>
<!ELEMENT acteur (nom, naissance)>
<!ELEMENT nom (#PCDATA)>
<!ELEMENT naissance (#PCDATA)>
<!ATTLIST film
  ident ID #REQUIRED
  ref_acteurs IDREFS #REQUIRED
>
<!ATTLIST acteur
  ident ID #REQUIRED
  ref_films IDREFS #REQUIRED
>
]>

<mes_donnees_cinema>
  <!-- Les films -->
  <les_films>
    <film ident="apocalysenow" ref_acteurs="ford fishburne">
      <titre> Apocalypse Now </titre>
      <annee> 1979 </annee>
      <realisation>Francis Ford Coppola</realisation>
    </film>

    <film ident="starwars" ref_acteurs="ford">
      <titre> Star Wars </titre>
      <annee> 1977 </annee>
      <realisation>George Lucas</realisation>
    </film>
  </les_films>

  <!-- Les acteurs -->
  <les_acteurs>
    <acteur ident="fishburne" ref_films="apocalysenow">
      <nom>Larry Fishburne</nom>
      <naissance>30 juillet 1965</naissance>   
    </acteur>

    <acteur ident="ford" ref_films="apocalysenow starwars">
      <nom>Harrison Ford</nom>
      <naissance>13 juillet 1942</naissance>   
    </acteur>
  </les_acteurs>

</mes_donnees_cinema>