% Pour PageRank  
  
\newcount\id
\newcounter{local}
\newcounter{tempcnta}
\newboolean{tempswa}
\newcounter{nb}
\newcounter{nbminusone}
\newcounter{nbplusone}
\newcommand*{\tempa}{}


\newcommand*{\countfiles}[1]{%
  \renewcommand*{\tempa}[1]{#1}%
  \setcounter{tempcnta}{0}%
  \IfFileExists{\tempa{\thetempcnta}}%
    {\setboolean{tempswa}{true}}%
    {\setboolean{tempswa}{false}}%
  \whiledo{\boolean{tempswa}}{%
    \stepcounter{tempcnta}%
    \IfFileExists{\tempa{\thetempcnta}}%
      {\setboolean{tempswa}{true}}%
      {\setboolean{tempswa}{false}}%
  }%
} 


\newcommand*{\graphimage}[2]{%
\only<#1>{\hspace{5em}\includegraphics[height=.8\vsize]{./images/#2}}}

\newcommand*{\iterations}[1]{%
  \countfiles{./images/#1-##1.eps}%
  \setcounter{nb}{\thetempcnta}%
  \setcounter{nbminusone}{\thetempcnta}%
  \addtocounter{nbminusone}{-1}%
  \transduration<2-5>{1}%
  \transduration<6-\thenbminusone>{0.5}%
  \animatevalue<1-\thenb>{\id}{0}{\thenbminusone}%
  \setcounter{local}{\the\id+1}%
  \graphimage{\thelocal}{#1-\the\id}
}


