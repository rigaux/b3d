language=myXQuery]{#2}}}

%% Inclusion of a PiP example

\newcommand{\pipfile}[3]{%
{\small
\lstinputlisting[frame=lines,language=#3]{../PiP-examples/#1}
}
}

% File inclusion
\def\testFile#1#2{%
\typeout{File: #1}
\IfFileExists{#1}{#2}}

\newcommand{\FileInSlide}[1]{%
\testFile{#1}{%
{\small\verbatiminput{#1}}}{\errorlog{File '#1' does not exist!}}
}

% Used to show the context node of an XPath evaluation
\newcommand{\contextNode}[1]{%
\MySolidShadowBox{\textcolor{red}{#1}}{}
}

